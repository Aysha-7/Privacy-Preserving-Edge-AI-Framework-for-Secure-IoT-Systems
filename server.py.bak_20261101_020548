    el.textContent = finalText.split("").map((c,i) =>
      (c === " " || i < n/1.2) ? c : chars[Math.floor(Math.random()*chars.length)]).join("");
    if(n > finalText.length*1.2 + 4){ clearInterval(id); el.textContent = finalText; }
  }, 30);
}

