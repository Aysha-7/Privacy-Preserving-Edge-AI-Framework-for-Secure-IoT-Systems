def _read_private_text_file(path):
    try:
        value = path.read_text(encoding="utf-8").strip()
        return value if value else ""
    except OSError:
        return ""

TELEGRAM_BOT_TOKEN = _read_private_text_file(TELEGRAM_TOKEN_FILE)
TELEGRAM_CHAT_ID = _read_private_text_file(TELEGRAM_CHAT_FILE)

TELEGRAM_ALERT_COOLDOWN_SECONDS = 60
_TELEGRAM_ALERT_LOCK = threading.Lock()
_TELEGRAM_LAST_SENT = {}

def send_telegram_alert_async(alert_type, message):
    """
    Queue a plain-text Telegram alert to the one locally configured chat.
    No image, encryption key, Cloudinary URL, or bot token is sent in chat.
    """
    if not TELEGRAM_BOT_TOKEN or not TELEGRAM_CHAT_ID:
        app.logger.warning(
            "Telegram alert skipped: local bot token or chat ID file is missing."
        )
        return

    now = time.monotonic()
    with _TELEGRAM_ALERT_LOCK:
        previous = _TELEGRAM_LAST_SENT.get(alert_type, 0.0)
        if now - previous < TELEGRAM_ALERT_COOLDOWN_SECONDS:
            app.logger.info(
                "Telegram %s alert suppressed by cooldown.", alert_type
            )
            return
        _TELEGRAM_LAST_SENT[alert_type] = now

    def _send():
        try:
            response = requests.post(
                f"https://api.telegram.org/bot{TELEGRAM_BOT_TOKEN}/sendMessage",
                json={
                    "chat_id": TELEGRAM_CHAT_ID,
                    "text": message,
                    "disable_web_page_preview": True,
                },
                timeout=10,
            )
            response.raise_for_status()
            result = response.json()
            if not result.get("ok"):
                raise RuntimeError("Telegram API did not confirm delivery.")
            app.logger.info("Telegram %s text alert sent.", alert_type)
        except Exception:
            # Never log the request URL because it contains the bot token.
            app.logger.exception("Telegram %s text alert failed.", alert_type)
            with _TELEGRAM_ALERT_LOCK:
                _TELEGRAM_LAST_SENT.pop(alert_type, None)

    threading.Thread(
        target=_send,
        name=f"telegram-{alert_type}-alert",
        daemon=True,
    ).start()



