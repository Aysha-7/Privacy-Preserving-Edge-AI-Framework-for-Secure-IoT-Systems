def canonical_json(value):
    return json.dumps(
        value,
        sort_keys=True,
        separators=(",", ":"),
        ensure_ascii=False,
    )


def calculate_block_hash(block):
    contents = {
        "index": block["index"],
        "timestamp_utc": block["timestamp_utc"],
        "event": block["event"],
        "previous_hash": block["previous_hash"],
    }

    return hashlib.sha256(
        canonical_json(contents).encode("utf-8")
    ).hexdigest()


def initialize_csv():
    with CSV_LOCK:
        if not DATA_FILE.exists() or DATA_FILE.stat().st_size == 0:
            with DATA_FILE.open(
                "a",
                newline="",
                encoding="utf-8",
            ) as file:
                writer = csv.DictWriter(
                    file,
                    fieldnames=CSV_COLUMNS,
                )
                writer.writeheader()


def read_chain():
    if not CHAIN_FILE.exists():
        return []

    blocks = []

    with CHAIN_FILE.open("r", encoding="utf-8") as file:
        for line_number, line in enumerate(file, start=1):
            if not line.strip():
                continue

            try:
                blocks.append(json.loads(line))
            except json.JSONDecodeError as exc:
                raise ValueError(
                    f"Invalid JSON at chain line {line_number}"
                ) from exc

    return blocks


def append_block(event):
    with CHAIN_LOCK:
        blocks = read_chain()

        previous_hash = (
            blocks[-1]["hash"] if blocks else GENESIS_HASH
        )

        block = {
            "index": len(blocks),
            "timestamp_utc": event["timestamp_utc"],
            "event": event,
            "previous_hash": previous_hash,
        }

        block["hash"] = calculate_block_hash(block)

        with CHAIN_FILE.open("a", encoding="utf-8") as file:
            file.write(canonical_json(block) + "\n")

        return block


initialize_csv()


