def _s4_health():
    def info(key):
        item = S4_LAST_STEP.get(key)

        if not item:
            return {"state": "idle", "age": None}

        return {
            "state": "ok" if item["status"] == "ok" else "bad",
            "age": int(time.time() - item["t"]),
