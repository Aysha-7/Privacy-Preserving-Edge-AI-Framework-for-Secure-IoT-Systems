        wipe += 0.045 * wipeDir;
        if (wipe >= 1) { wipeDir = -1; wipe = 1; nextWipe = Infinity; setTimeout(function(){ wipeDir = -1; }, 0); }
        if (wipeDir === -1 && wipe <= 0) { wipe = -1; nextWipe = frame + 120 + Math.floor(Math.random() * 160); }
      }
    }
    var open = blink > 0 ? Math.abs(1 - blink) : 1;
    open = Math.max(0.04, open);
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = green;
    var glitchRows = {};
    if (!reduce && Math.random() < 0.05) {
      for (var g = 0; g < 4; g++) glitchRows[Math.floor(Math.random() * gh)] = Math.floor(Math.random() * 9 - 4);
    }
    for (var j = 0; j < gh; j++) {
      var shift = glitchRows[j] || 0;
      for (var i = 0; i < gw; i++) {
        if (wipe >= 0 && (i / gw + j / gh * 0.6) / 1.6 < wipe) continue;
        var l = lum(i - shift, j, open, look.x, look.y);
        if (l <= 0.03) continue;
        var rad = cell * 0.5 * Math.pow(l, 0.75);
        ctx.beginPath();
        ctx.arc(i * cell + cell / 2 + shift * 0, j * cell + cell / 2, rad, 0, 6.2832);
        ctx.fill();
      }
    }
  }
  var timer = setInterval(draw, 55);
  draw();
  return function stop(){ clearInterval(timer); };
}

